# Copy this file to .env and fill in real values.
# Never commit the real .env file (already in .gitignore).

# ── LLM: Groq is primary, Gemini is the automatic fallback ─────────────
# Groq free tier: https://console.groq.com
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# ── Optional: live market news headline enrichment ──────────────────────
# Not required — modules/market/investment.py already pulls headlines from
# yfinance's built-in .news for free. No key needed here.

# ── Optional: equity-research valuation assumptions ─────────────────────
# Configured assumptions (not live data) -- every research report lists them.
# Defaults shown; update when the 10-year G-sec yield / risk premium move.
FI_RISK_FREE_RATE=0.0675
FI_EQUITY_RISK_PREMIUM=0.07
FI_TERMINAL_GROWTH=0.05
# Company headlines via Google News' public RSS search (no key). 0 = off.
FI_NEWS_RSS=1

# ── Optional: Tavus CVI avatar mode (paid, WebRTC video avatar) ─────────
# Only needed for "Tavus CVI Mode (WebRTC)" in the Chat tab. The default
# "Conversational Mode" avatar (TalkingHead, interface/avatar/) is free
# and self-hosted-in-browser and needs none of these.
# Tavus dashboard: https://platform.tavus.io
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
# ngrok free tier: https://dashboard.ngrok.com — tunnels ARIA's local
# custom-LLM server so Tavus's cloud can reach it.
NGROK_AUTHTOKEN=

# Persistent chat memory (uses the existing DB_URL database; no memory service).
ARIA_MEMORY_SEMANTIC=1
ARIA_MEMORY_SEMANTIC_CANDIDATES=200
ARIA_MEMORY_TOKEN_BUDGET=6000
# Set to the smallest context window among your configured primary/fallback models.
ARIA_MODEL_CONTEXT_TOKENS=32768
ARIA_RESPONSE_RESERVE_TOKENS=4096
# Optional local, model-matched tokenizer directory. Empty uses a UTF-8 upper bound.
ARIA_TOKENIZER_PATH=
# Opt-in developer diagnostics; returns record ids/counts, never transcript text.
ARIA_CONTEXT_DEBUG=0
# Interrupted workers' request claims expire after this period.
ARIA_REQUEST_LEASE_SECONDS=1800

# Selective intent interpretation: uses the same Groq MODEL_NAME; one bounded call.
ARIA_INTENT_RESOLVER=1
ARIA_INTENT_TIMEOUT_SECONDS=8
ARIA_INTENT_MIN_CONFIDENCE=0.8

# Per-worker admission; put deployment-wide quotas at a trusted reverse proxy.
# Overall wire body includes multipart overhead; individual audio/statement limits remain smaller.
ARIA_MAX_REQUEST_BYTES=12582912
ARIA_MAX_ACTIVE_REQUESTS=16
# POST requests and live websocket openings per real socket peer / minute; 0 disables rate limiting.
ARIA_EXPENSIVE_REQUESTS_PER_MINUTE=120

# Keep the current private local app, or require accounts for application routes.
# Existing private data is not automatically claimed by newly registered accounts.
ARIA_AUTH_MODE=private
# python -m api.main binds loopback by default. Expose deliberately only with appropriate deployment controls.
ARIA_BIND_HOST=127.0.0.1
# Exact browser origin. HTTPS is required outside loopback.
ARIA_APP_ORIGIN=http://localhost:5173
# Enable only when you intend to accept new accounts; email delivery/reset is not configured.
ARIA_AUTH_ALLOW_SIGNUP=0
# Google OAuth Web client ID; configure the same origin in Google Cloud Console.
# Email/password works independently; blank hides Google sign-in.
GOOGLE_CLIENT_ID=
