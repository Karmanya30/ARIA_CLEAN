.env
env
.venv/
__pycache__/
.audit/
.tmp_pytest*/
*.bak
web/test-results/
web/playwright-report/
*.py[cod]

# local binaries / logs / runtime DB — never commit these
data/bin/
data/*.log
*.log
data/user_profiles/*.db
data/user_profiles/audio-cache/
# vector index is rebuilt from data/raw/concepts_kb/concepts.json via
# python -m scripts.build_concept_kb — never committed
data/vector_store/

# trained model artifacts — regenerate via scripts/train scripts, not committed
models/**/*.json
models/**/*.pt
models/**/*.joblib
models/**/*.zip
models/tts/
models/nlp/
!models/.gitkeep

# synthetic training data — deterministic (RANDOM_STATE=42), regenerate via
# the matching scripts instead of committing. concepts.json is hand-authored
# and NOT ignored — that one is real curated content.
data/raw/transactions_synthetic/
data/raw/kt_sequences/

# Tavus CVI runtime state — regenerated each run, machine-specific (ngrok
# URL) or safe-but-pointless to commit (cached persona_id)
interface/avatar/ngrok_url.txt
interface/avatar/ngrok_error.txt
interface/avatar/.tavus_persona_cache.json

# forecast engine artefacts
data/forecast_runs/
data/forecast_cache/
data/user_profiles/*.db-wal
data/user_profiles/*.db-shm
data/forecast_universe/

# instrument catalogue caches (AMFI NAV file, mfapi history, CoinGecko list)
data/instruments/

# scenario backtest: generated results, caches and sweep state (large, re-creatable)
data/scenario_backtest/

# local avatar engine replicas/samples (photos of people, generated media)
data/avatar/
models/avatar/
